{
    "name": "api",
    "version": "1.0.0",
    "private": true,
    "scripts": {
        "dev": "tsx watch --env-file=.env src/server.ts",
        "build": "tsc",
        "start": "node dist/server.js",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "devEngines": {
        "packageManager": {
            "name": "pnpm",
            "version": "12.21.0",
            "onFail": "download"
        }
    },
    "packageManager": "pnpm@12.21.0",
    "type": "module",
    "dependencies": {
        "@asteasolutions/zod-to-openapi": "^9.1.0",
        "@prisma/client": "^7.10.1",
        "express": "^5.3.0",
        "pino": "^10.4.0",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@types/express": "^5.0.6",
        "@types/node": "^26.6.6",
        "@types/supertest": "^7.2.1",
        "pino-pretty": "^13.2.0",
        "prisma": "7.10.1",
        "supertest": "^7.3.2",
        "tsx": "^4.23.15",
        "typescript": "^7.0.2",
        "vitest": "^5.1.0"
    }
}